 (ArchiCG, Boldo, low-code) qui accélèrent la conception, la preuve de valeur, et la transformation.\nExemple Honda : Châssis modulaire → ici : modèles et outils modulaires, reproductibles, interopérables.","expandcollapseRenderedStartX":220.3784261155114,"expandcollapseRenderedStartY":81.17974978761185,"expandcollapseRenderedCueSize":12,"size-before-collapse":{"w":242,"h":170},"collapsedChildren":null,"x-before-fisheye":311.5,"y-before-fisheye":5671.104396474508,"width-before-fisheye":242,"height-before-fisheye":170},"position":{"x":862.6646753476523,"y":-4725.79954213585},"group":"nodes","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":false,"classes":""},{"data":{"id":"cefa0409-8aed-4dcc-a3af-a52498f24c24","timestamp":"2025-06-22T11:42:12.457Z","type":"business-actor","label":"Regis Ravalec","position":{"x":100,"y":100},"parent":"0880c859-0220-4036-bb57-e25ded07a127"},"position":{"x":1472.5777415464356,"y":-4375.807378665238},"group":"nodes","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":false,"classes":""},{"data":{"id":"7794fe30-01b8-439d-a91a-8778abc50dd4","timestamp":"2025-06-22T11:40:44.084Z","type":"business-actor","label":"Xavier Malaury","position":{"x":100,"y":100},"parent":"0880c859-0220-4036-bb57-e25ded07a127"},"position":{"x":2052.712772738094,"y":-4673.59566815847},"group":"nodes","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":false,"classes":""},{"data":{"id":"bcf47616-5da0-44ab-937b-4b6914c68746","timestamp":"2025-06-22T11:39:04.732Z","type":"business-actor","label":"Vincen Henry","position":{"x":100,"y":100},"parent":"0880c859-0220-4036-bb57-e25ded07a127"},"position":{"x":1400.3400009594059,"y":-4768.511664904971},"group":"nodes","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":false,"classes":""},{"data":{"id":"a994ac90-bc17-4884-9740-bedc500f37d8","timestamp":"2025