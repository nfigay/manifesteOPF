:40:44.084Z","type":"business-actor","label":"Xavier Malaury","position":{"x":100,"y":100},"parent":"0880c859-0220-4036-bb57-e25ded07a127"},"position":{"x":2052.712772738094,"y":-4673.59566815847},"group":"nodes","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":false,"classes":""}}},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":"cy-expand-collapse-meta-edge"},{"data":{"source":"640cc64e-92a5-41af-b75e-1e65079b7018","target":"5bcbfd8a-29ca-42c5-8b97-c5411b9268cd","edgeType":"association","id":"702e9ee7-e288-467d-83d7-4201f7b6e015","level":"2","justification":"Nicolas cartographie les systèmes complexes, modélise les interactions inter-métiers et conçoit des architectures centrées sur l’interopérabilité et la traçabilité.","opflevel":"2"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"640cc64e-92a5-41af-b75e-1e65079b7018","target":"9420a24b-49c4-4032-bf56-5ff349d9bb02","edgeType":"association","id":"1d92f95d-d4f4-43df-9a61-60578863a1ed","level":"2","originalEnds":{"source":{"data":{"id":"640cc64e-92a5-41af-b75e-1e65079b7018","timestamp":"2025-06-22T11:19:12.886Z","type":"business-actor","label":"Nicolas Figay","position":{"x":100,"y":100},"parent":"0880c859-0220-4036-bb57-e25ded07a127","description":null,"justification":"Nicolas Figay est parfaitement aligné avec les 3 piliers. Il combine expertise technique, innovation libre, esprit critique, et pédagogie. Il offre une alternative souveraine, frugale et partagée à l’architecture d’entreprise, centrée sur les utilisateurs, la modélisation et la collaboration visuelle.","profile":"Nicolas Figay est ingénieur et chercheur, expert de l’interopérabilité, de l’architecture d’entreprise et du Model-Based Systems Engineering (MBSE). Fort de 30 ans chez Airbus, il conjugue rigueur académique et expérience industrielle pour faciliter la collaboration entre systèmes, métiers et disciplines. Il s’appuie sur des standards comme ArchiMate, SysML et les ontologies pour concevoir des cadres méthodologiques interopérables, notamment autour de STEP (AP242). Fondateur d’ArchiCG, une solution open-source de cartographie sémantique interactive, il milite pour des outils accessibles, non contraints par l’IT centralisé, et capables de croiser visuel, interactivité et sémantique. Il promeut une architecture ouverte, explicable, traçable, critique dans des secteurs comme l’aéronautique. Son approche est à la fois visionnaire et pragmatique : redonner aux ingénieurs et architectes le pouvoir d’agir sur leur environnement numérique, hors des carcans IT traditionnels.","presentation":"Nicolas Figay intervient comme une voix singulière dans l’écosystème de l’architecture d’entreprise. Ni consultant, ni vendeur, mais ingénieur en activité chez Airbus, il mène une réflexion profonde sur l’interopérabilité continue au sein des systèmes numériques industriels. Son constat : les ingénieurs sont de plus en plus dépendants de systèmes informatiques hétérogènes, souvent incompatibles, qui complexifient la collaboration inter-départements et inter-entreprises. Les outils actuels, souvent lourds ou fermés, freinent l’agilité, le partage de données, et mènent à des pratiques non contrôlées (Shadow IT, fichiers Excel, mails). Il développe alors ArchiCG, un outil libre, sans serveur ni installation, permettant à chacun de cartographier ses systèmes via des graphes sémantiques interactifs. L’outil se fonde sur ArchiMate mais permet d’intégrer tout type de référentiel ou d’ontologie métier. Il repose sur une philosophie d’ouverture, de portabilité et de réutilisabilité, pour favoriser la collaboration par le visuel et la donnée structurée. Il défend une vision rigoureuse : l’IA doit s’intégrer dans les systèmes via des architectures explicables, traçables et souveraines. Il alerte sur l’opacité des modèles IA actuels, leur manque d’exhaustivité et d’explicabilité, particulièrement dangereux dans les systèmes critiques (ex. aéronautique). Pour lui, l’IA ne remplace pas l’architecture, elle en dépend. Nicolas milite pour une hybridation des méthodes : MBSE, cartographies sémantiques, visualisation dynamique, normalisation, tout en refusant les lourdeurs des progiciels ou plateformes figées. Sa proposition de valeur : redonner du pouvoir aux utilisateurs, créer un socle commun de représentation partagé, pour faire émerger des environnements de travail plus libres, ouverts, réflexifs et collaboratifs. Il rejoint ainsi le manifeste Open People Factory par ses valeurs : pragmatisme, partage, autonomie et qualité des fondations numériques.","positionnement-OPF":"Nicolas Figay est parfaitement aligné avec les 3 piliers. Il combine expertise technique, innovation libre, esprit critique, et pédagogie. Il offre une alternative souveraine, frugale et partagée à l’architecture d’entreprise, centrée sur les utilisateurs, la modélisation et la collaboration visuelle."},"position":{"x":1873.3271301867067,"y":-5133.933149226275},"group":"nodes","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":false,"classes":""},"target":{"data":{"id":"7a81606d-7e6d-46da-b64f-01e125da04a8","timestamp":"2025-06-22T11:51:58.427Z","type":"grouping","label":"Savoir être","position":{"x":100,"y":100},"parent":"9420a24b-49c4-4032-bf56-5ff349d9bb02"},"position":{"x":1820.1121743072852,"y":239.52555656617875},"group":"nodes","removed":true,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":false,"classes":""}},"justification":"Sa posture est celle d’un engagé humble et constructif, qui agit de l’intérieur, avec exigence technique et esprit de service collectif.","opflevel":"2"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":"cy-expand-collapse-meta-edge"},{"data":{"source":"1fe3f72f-dfef-4a94-a056-b05102f3b173","target":"8c8c0de0-7c04-4017-87b3-35747e6ee2dd","edgeType":"composition","id":"c18fefd2-805b-40fb-9a61-4dd688126886"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"20dfb506-e18c-477a-b733-38e0d6d78769","target":"a994ac90-bc17-4884-9740-bedc500f37d8","edgeType":"composition","id":"ec228c27-8489-402e-b583-3de95ad2dc0c","originalEnds":{"source":{"data":{"id":"d62b56e6-53da-45b6-9c42-6abc4f80150f","timestamp":"2025-06-22T11:30:01.581Z","type":"business-actor","label":"Amalte","position":{"x":100,"y":100},"parent":"20dfb506-e18c-477a-b733-38e0d6d78769"},"position":{"x":112.7978191166988,"y":-10.829045219211594},"group":"nodes","removed":true,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":false,"classes":""},"target":{"data":{"id":"a994ac90-bc17-4884-9740-bedc500f37d8","timestamp":"2025-06-22T11:29:51.114Z","type":"business-actor","label":"louis-pierre.guillaume","position":{"x":100,"y":100},"parent":"0880c859-0220-4036-bb57-e25ded07a127"},"position":{"x":1554.4541733365477,"y":-4471.188750083588},"group":"nodes","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":false,"classes":""}}},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":"cy-expand-collapse-meta-edge"},{"data":{"source":"20dfb506-e18c-477a-b733-38e0d6d78769","target":"595a3e10-843e-4116-b98d-27d669e7441c","edgeType":"composition","id":"aafc4640-e63a-4bb1-8a5e-15c4152ca0df","originalEnds":{"source":{"data":{"id":"9b47d3a5-d5e9-4d26-936b-b039fb005e34","timestamp":"2025-06-22T11:34:47.302Z","type":"business-actor","label":"Tim-Promédial","position":{"x":100,"y":100},"parent":"20dfb506-e