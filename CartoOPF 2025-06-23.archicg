nnable":true,"classes":"cy-expand-collapse-meta-edge"},{"data":{"source":"1fe3f72f-dfef-4a94-a056-b05102f3b173","target":"f9e8ad19-cfb4-4230-a454-bad6bb391adf","edgeType":"composition","id":"ae61d5a1-cb05-42cb-884f-7a0188150e65"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"1fe3f72f-dfef-4a94-a056-b05102f3b173","target":"640cc64e-92a5-41af-b75e-1e65079b7018","edgeType":"composition","id":"66d8d7ba-8889-4fda-8cf6-541956208a1a"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"1fe3f72f-dfef-4a94-a056-b05102f3b173","target":"b08fa0d0-b97a-48e3-a74b-43c2bf2c22e6","edgeType":"composition","id":"3bb2c387-7178-4b68-b880-933c58250d75"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"1fe3f72f-dfef-4a94-a056-b05102f3b173","target":"45bc429f-3e8b-42dd-b736-441ce09e2e66","edgeType":"composition","id":"72d78b0b-2569-4530-a88e-72ded578a1d8"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"1fe3f72f-dfef-4a94-a056-b05102f3b173","target":"91e01b3b-97e9-419b-8bad-c8d8f1a42366","edgeType":"composition","id":"7a6c6105-693b-47bb-a492-8677fb669d0c"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"1fe3f72f-dfef-4a94-a056-b05102f3b173","target":"4884b855-aa97-4ae5-a1b7-d80bd72bbff4","edgeType":"composition","id":"e8a9e806-ac17-4934-9b18-8be052ee104f"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"1fe3f72f-dfef-4a94-a056-b05102f3b173","target":"0d4d6ffd-7e77-4b68-8c0c-c1818eacab36","edgeType":"composition","id":"f23eed53-dbb6-4d7a-9a46-e5607aa11324"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"1fe3f72f-dfef-4a94-a056-b05102f3b173","target":"3d04b3f1-4248-4604-9db5-fdaf5d9e4f5f","edgeType":"composition","id":"be085dcf-4e16-4fa0-a62e-3e18bd777bc6"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"1fe3f72f-dfef-4a94-a056-b05102f3b173","target":"d9ad9e96-098d-4ed4-8139-1c418355f5d1","edgeType":"composition","id":"bed22d31-0cda-4231-a8e8-8f122178e519"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"1fe3f72f-dfef-4a94-a056-b05102f3b173","target":"0a3f9d08-9e22-435e-86ef-b04df7437e47","edgeType":"composition","id":"98efad68-41d2-45c7-908f-bee47292646f"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"1fe3f72f-dfef-4a94-a056-b05102f3b173","target":"5b845855-60cd-4bc8-84f1-ef261cf021d4","edgeType":"composition","id":"3d8a2a2d-2630-4a9d-b38f-772827402d49"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"1fe3f72f-dfef-4a94-a056-b05102f3b173","target":"f61ea6ae-bce5-4aef-9828-c46521c07923","edgeType":"composition","id":"22e86c11-87db-410c-938b-d54ad7846382"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"1fe3f72f-dfef-4a94-a056-b05102f3b173","target":"6fe61a2b-bd8a-41e3-bf0c-fc19d1e0e86a","edgeType":"composition","id":"9fa5b979-698f-49db-9452-284aad63f1ca"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"1fe3f72f-dfef-4a94-a056-b05102f3b173","target":"a1fd5d26-eb99-4392-bd80-0c4742f4e53e","edgeType":"composition","id":"873d8cf8-e5e5-47f6-b2c6-0f13b811badd"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":""},{"data":{"source":"640cc64e-92a5-41af-b75e-1e65079b7018","target":"9420a24b-49c4-4032-bf56-5ff349d9bb02","edgeType":"association","id":"0703cc92-e374-43ac-8d31-a66292e368c5","level":"2","originalEnds":{"source":{"data":{"id":"640cc64e-92a5-41af-b75e-1e65079b7018","timestamp":"2025-06-22T11:19:12.886Z","type":"business-actor","label":"Nicolas Figay","position":{"x":100,"y":100},"parent":"0880c859-0220-4036-bb57-e25ded07a127","description":null,"justification":"Nicolas Figay est parfaitement aligné avec les 3 piliers. Il combine expertise technique, innovation libre, esprit critique, et pédagogie. Il offre une alternative souveraine, frugale et partagée à l’architecture d’entreprise, centrée sur les utilisateurs, la modélisation et la collaboration visuelle.","profile":"Nicolas Figay est ingénieur et chercheur, expert de l’interopérabilité, de l’architecture d’entreprise et du Model-Based Systems Engineering (MBSE). Fort de 30 ans chez Airbus, il conjugue rigueur académique et expérience industrielle pour faciliter la collaboration entre systèmes, métiers et disciplines. Il s’appuie sur des standards comme ArchiMate, SysML et les ontologies pour concevoir des cadres méthodologiques interopérables, notamment autour de STEP (AP242). Fondateur d’ArchiCG, une solution open-source de cartographie sémantique interactive, il milite pour des outils accessibles, non contraints par l’IT centralisé, et capables de croiser visuel, interactivité et sémantique. Il promeut une architecture ouverte, explicable, traçable, critique dans des secteurs comme l’aéronautique. Son approche est à la fois visionnaire et pragmatique : redonner aux ingénieurs et architectes le pouvoir d’agir sur leur environnement numérique, hors des carcans IT traditionnels.","presentation":"Nicolas Figay intervient comme une voix singulière dans l’écosystème de l’architecture d’entreprise. Ni consultant, ni vendeur, mais ingénieur en activité chez Airbus, il mène une réflexion profonde sur l’interopérabilité continue au sein des systèmes numériques industriels. Son constat : les ingénieurs sont de plus en plus dépendants de systèmes informatiques hétérogènes, souvent incompatibles, qui complexifient la collaboration inter-départements et inter-entreprises. Les outils actuels, souvent lourds ou fermés, freinent l’agilité, le partage de données, et mènent à des pratiques non contrôlées (Shadow IT, fichiers Excel, mails). Il développe alors ArchiCG, un outil libre, sans serveur ni installation, permettant à chacun de cartographier ses systèmes via des graphes sémantiques interactifs. L’outil se fonde sur ArchiMate mais permet d’intégrer tout type de référentiel ou d’ontologie métier. Il repose sur une philosophie d’ouverture, de portabilité et de réutilisabilité, pour favoriser la collaboration par le visuel et la donnée structurée. Il défend une vision rigoureuse : l’IA doit s’intégrer dans les systèmes via des architectures explicables, traçables et souveraines. Il alerte sur l’opacité des modèles IA actuels, leur manque d’exhaustivité et d’explicabilité, particulièrement dangereux dans les systèmes critiques (ex. aéronautique). Pour lui, l’IA ne remplace pas l’architecture, elle en dépend. Nicolas milite pour une hybridation des méthodes : MBSE, cartographies sémantiques, visualisation dynamique, normalisation, tout en refusant les lourdeurs des progiciels ou plateformes figées. Sa proposition de valeur : redonner du pouvoir aux utilisateurs, créer un socle commun de représentation partagé, pour faire émerger des environnements de travail plus libres, ouverts, réflexifs et collaboratifs. Il rejoint ainsi le manifeste Open People Factory par ses valeurs : pragmatisme, partage, autonomie et qualité des fondations numériques.","positionnement-OPF":"Nicolas Figay est parfaitement aligné avec les 3 piliers. Il combine expertise technique, innovation libre, esprit critique, et pédagogie. Il offre une alternative souveraine, frugale et partagée à l’architecture d’entreprise, centrée sur les utilisateurs, la modélisation et la collaboration visuelle."},"position":{"x":1873.3271301867067,"y":-5133.933149226275},"group":"nodes","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":false,"classes":""},"target":{"data":{"id":"41cf0603-5a88-4aa6-9f6c-ddc1b239d900","timestamp":"2025-06-22T11:52:06.745Z","type":"grouping","label":"Culture","position":{"x":100,"y":100},"parent":"9420a24b-49c4-4032-bf56-5ff349d9bb02"},"position":{"x":1712.199437783539,"y":243.70459332927197},"group":"nodes","removed":true,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":false,"classes":""}},"jusification":"Il promeut une culture d’autonomie, d’open source, de critique des systèmes centralisés et d’empowerment des ingénieurs.","opflevel":"2"},"position":{"x":0,"y":0},"group":"edges","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":true,"classes":"cy-expand-collapse-meta-edge"},{"data":{"source":"640cc64e-92a5-41af-b75e-1e65079b7018","target":"9420a24b-49c4-4032-bf56-5ff349d9bb02","edgeType":"association","id":"68bb735e-0c41-4dd9-a9f3-6cc4a702a9c2","level":"2","originalEnds":{"source":{"data":{"id":"640cc64e-92a5-41af-b75e-1e65079b7018","timestamp":"2025-06-22T11:19:12.886Z","type":"business-actor","label":"Nicolas Figay","position":{"x":100,"y":100},"parent":"0880c859-0220-4036-bb57-e25ded07a127","description":null,"justification":"Nicolas Figay est parfaitement aligné avec les 3 piliers. Il combine expertise technique, innovation libre, esprit critique, et pédagogie. Il offre une alternative souveraine, frugale et partagée à l’architecture d’entreprise, centrée sur les utilisateurs, la modélisation et la collaboration visuelle.","profile":"Nicolas Figay est ingénieur et chercheur, expert de l’interopérabilité, de l’architecture d’entreprise et du Model-Based Systems Engineering (MBSE). Fort de 30 ans chez Airbus, il conjugue rigueur académique et expérience industrielle pour faciliter la collaboration entre systèmes, métiers et disciplines. Il s’appuie sur des standards comme ArchiMate, SysML et les ontologies pour concevoir des cadres méthodologiques interopérables, notamment autour de STEP (AP242). Fondateur d’ArchiCG, une solution open-source de cartographie sémantique interactive, il milite pour des outils accessibles, non contraints par l’IT centralisé, et capables de croiser visuel, interactivité et sémantique. Il promeut une architecture ouverte, explicable, traçable, critique dans des secteurs comme l’aéronautique. Son approche est à la fois visionnaire et pragmatique : redonner aux ingénieurs et architectes le pouvoir d’agir sur leur environnement numérique, hors des carcans IT traditionnels.","presentation":"Nicolas Figay intervient comme une voix singulière dans l’écosystème de l’architecture d’entreprise. Ni consultant, ni vendeur, mais ingénieur en activité chez Airbus, il mène une réflexion profonde sur l’interopérabilité continue au sein des systèmes numériques industriels. Son constat : les ingénieurs sont de plus en plus dépendants de systèmes informatiques hétérogènes, souvent incompatibles, qui complexifient la collaboration inter-départements et inter-entreprises. Les outils actuels, souvent lourds ou fermés, freinent l’agilité, le partage de données, et mènent à des pratiques non contrôlées (Shadow IT, fichiers Excel, mails). Il développe alors ArchiCG, un outil libre, sans serveur ni installation, permettant à chacun de cartographier ses systèmes via des graphes sémantiques interactifs. L’outil se fonde sur ArchiMate mais permet d’intégrer tout type de référentiel ou d’ontologie métier. Il repose sur une philosophie d’ouverture, de portabilité et de réutilisabilité, pour favoriser la collaboration par le visuel et la donnée structurée. Il défend une vision rigoureuse : l’IA doit s’intégrer dans les systèmes via des architectures explicables, traçables et souveraines. Il alerte sur l’opacité des modèles IA actuels, leur manque d’exhaustivité et d’explicabilité, particulièrement dangereux dans les systèmes critiques (ex. aéronautique). Pour lui, l’IA ne remplace pas l’architecture, elle en dépend. Nicolas milite pour une hybridation des méthodes : MBSE, cartographies sémantiques, visualisation dynamique, normalisation, tout en refusant les lourdeurs des progiciels ou plateformes figées. Sa proposition de valeur : redonner du pouvoir aux utilisateurs, créer un socle commun de représentation partagé, pour faire émerger des environnements de travail plus libres, ouverts, réflexifs et collaboratifs. Il rejoint ainsi le manifeste Open People Factory par ses valeurs : pragmatisme, partage, autonomie et qualité des fondations numériques.","positionnement-OPF":"Nicolas Figay est parfaitement aligné avec les 3 piliers. Il combine expertise technique, innovation libre, esprit critique, et pédagogie. Il offre une alternative souveraine, frugale et partagée à l’architecture d’entreprise, centrée sur les utilisateurs, la modélisation et la collaboration visuelle."},"position":{"x":1873.3271301867067,"y":-5133.933149226275},"group":"nodes","removed":false,"selected":false,"selectable":true,"locked":false,"grabbable":true,"pannable":false,"classes":""},"target":{"data":{"id":"afc9d840-8c32-44a8-84cb-19b8db05c783","timesta